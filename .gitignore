# Verilator/verilated build directories (obj_dir_vl, obj_dir_core, obj_dir_cosim, ...) and the
# runners' locks beside them
obj_*/
obj_*.flock
core/obj_dir_rs/

# GENERATED device trees (tools/check-dts-timebase.py --gen, `make dtbs`).
# Tracking these stopped working once the model string carried the RTL commit: the file
# then contains the hash of the commit BEFORE it, so it is dirty immediately after every
# commit and committing it only makes it stale again. The template is the source.
workloads/ubuntu/ubuntu-nfs.dts
workloads/ubuntu/ubuntu-nfs.dtb
workloads/ubuntu/ubuntu-sd.dts
workloads/ubuntu/ubuntu-sd.dtb
workloads/ubuntu/ubuntu-nfs-166.dts
workloads/ubuntu/ubuntu-nfs-166.dtb
workloads/ubuntu/ubuntu-nfs-polled.dts
workloads/ubuntu/ubuntu-nfs-polled.dtb
workloads/ubuntu/ubuntu-nfs-4g.dts
workloads/ubuntu/ubuntu-nfs-4g.dtb
workloads/ubuntu/ubuntu-sd-4g.dts
workloads/ubuntu/ubuntu-sd-4g.dtb
workloads/tiny128/tiny128-cosim-blk-4g.dtb

# Serial console capture from `screen -L`. Grows without bound (17 MB when it was
# committed by mistake) and is a byproduct of every single boot. It was deliberately
# removed once in 9529c850 and re-added by a blanket `git add -A` -- the reason the
# rule below exists.
workloads/ubuntu/screenlog.0
workloads/*/screenlog.0

# Bare-metal microbenchmark build output. Generated by `make` from the .c, crt0.s and .ld
# in each directory; workloads/fphammer already left these untracked, which is the
# convention. Committed by mistake via `git add workloads/<dir>`.
workloads/aesbench/aesbench.bin
workloads/aesbench/aesbench.elf
workloads/fpbench/fpbench.bin
workloads/fpbench/fpbench.elf
workloads/ldbench/ldbench.bin
workloads/ldbench/ldbench.elf
workloads/blurbench/blurbench.bin
workloads/blurbench/blurbench.elf
workloads/mlbench/mlbench.bin
workloads/mlbench/mlbench.elf
tools/perftool/target/
workloads/saxpybench/saxpybench.bin
workloads/saxpybench/saxpybench.elf
# workloads/rvbench: what its `make clean` removes
workloads/rvbench/*.elf
workloads/rvbench/*.bin
workloads/rvbench/*.dump
workloads/rvbench/*.run.log
workloads/rvbench/*.trace
workloads/rvbench/syscalls-uart.c
workloads/rvbench/dhry-src/
sq/obj_dir_sq

# Ubuntu disk images -- 9.5 GB and 3.0 GB. Added by mistake in the dts commit via a
# blanket `git add -A workloads/`, which is why a push produced a pack over GitHub's
# 2 GiB limit. Kept out of the working tree's index permanently; the files themselves
# live on disk and are backed up outside the repo.
workloads/ubuntu/faster-ubuntu-25.04-preinstalled-server-riscv64.img
workloads/ubuntu/ubuntu-25.04-preinstalled-server-riscv64.img.zst
workloads/ubuntu/*.img
workloads/ubuntu/*.img.zst
gate-results/

# The monitor image a board's build bakes into the boot BRAM (build.tcl, its Makefile's MONITOR),
# and the one tools/netlist-boot.sh and tools/ooc-netlist.tcl read.
platforms/*/mem.linehex
src/mem.linehex
workloads/brbench/brbench.bin
workloads/brbench/brbench.elf

# Build outputs of the tracked Makefiles (2026-09-12): the bare-metal benches, the overlay
# harnesses and the compiled device trees. `make` in each directory regenerates them.
workloads/fphammer/*.bin
workloads/fphammer/*.elf
workloads/stbench/*.bin
workloads/stbench/*.elf
workloads/febench/*.bin
workloads/febench/*.elf
workloads/febench/febench_body.s
workloads/membench/*.bin
workloads/membench/*.elf
workloads/shabench/*.bin
workloads/shabench/*.elf
workloads/shabench/shabench
workloads/shabench/shalib
workloads/ddrhpm/ddrhpm
workloads/ipcstat/ipcstat
workloads/ipcstat/rdinstret
workloads/glibc/ov/
workloads/glibc/overlay.cpio
workloads/glibc/tiny128-glibc.cpio
workloads/sysd/ov/
workloads/sysd/overlay.cpio
workloads/sysd/tiny128-sysd.cpio
workloads/stress/ov/
workloads/stress/overlay.cpio
workloads/tiny128/tiny128-cosim-glibc.dt[sb]
workloads/pi/ov/
workloads/pi/overlay.cpio
workloads/pi/tiny128-pi.cpio
workloads/tiny128/tiny128-cosim-pi.dt[sb]
workloads/tiny128/tiny128-cosim-sysd.dt[sb]
workloads/tiny128/tiny128-simmerv.dtb
workloads/ubuntu/ubuntu-nfs-simmerv.dtb
workloads/ubuntu/ubuntu-nfs-simmerv2.dtb
workloads/gb5/gb5-fpga-polled.dtb
workloads/*/screenlog.*
tools/__pycache__/
*.pb
# B6: generated by workloads/tiny128/Makefile (cosim-blk)
workloads/tiny128/tiny128-blk.cpio
workloads/tiny128/tiny128-blk.img
# B4 memrand: generated op streams and binaries (workloads/memrand/Makefile)
workloads/memrand/ops-*.S
workloads/memrand/memrand-*.elf
workloads/memrand/memrand-*.bin
# per-config cosim build directories and their locks (core/run-cosim-linux.sh)
core/obj_dir_smolrv64_clinux*

# cargo build output of the in-tree Rust tools (tools/pipeview, tools/rvdisasm)
tools/*/target/
# Vivado writes these into the platform directory as it routes
platforms/*/clockInfo.txt
platforms/*/cong/
platforms/*/iter_*_CongestedCLBsAndNets.txt
