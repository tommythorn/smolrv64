[?2004l#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>

static void puthex64(uint64_t val) {
    printf("%04lx", val);
}

static void puts_(char *s) {
    printf("%s", s);
}

int main(int argc, char **argv) {
    uint64_t sum = 0;
    uint64_t xor = 0;
    uint64_t rol = 0;
    int c;
    uint64_t i = 0;

    while ((c = getchar()) >= 0) {
        uint64_t b = c & 255;
        sum += b;
        xor ^= b << ((i & 7) << 3);
        rol = (rol << 7) | (rol >> 57);
        rol ^= b + i;
        ++i;
    }

    printf("sum=");
    puthex64(sum);
    puts_(" xor=");
    puthex64(xor);
    puts_(" rol=");
    puthex64(rol);
    puts_(" len=");
    puthex64(i);
    putchar('\n');

    return 0;
}
