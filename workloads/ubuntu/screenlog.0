void qr(unsigned *a, unsigned *b, unsigned *c, unsigned *d) {[K
  *a += *b;  *d ^= *a;  *d = rotl(*d,16);[K
  *c += *d;  *b ^= *c;  *b = rotl(*b,12);[K
  *a += *b;  *d ^= *a;  *d = rotl(*d, 8);[K
  *c += *d;  *b ^= *c;  *b = rotl(*b, 7);[K
}[K
