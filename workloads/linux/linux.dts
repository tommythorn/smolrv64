/dts-v1/;

/ {
        #address-cells = <2>;
        #size-cells = <2>;
        compatible = "riscv-virtio";
        model = "SmolRV64 Linux 20260605";

        chosen {
                linux,initrd-start = <0 0x8762b000>;
                linux,initrd-end   = <0 0x87fff000>;
                bootargs = "console=ttyS0 earlycon=sbi root=/dev/raw rw ignore_loglevel";
                stdout-path = "/uart@10000000";
        };

        uart@10000000 {
                interrupts = <10>;
                interrupt-parent = <&plic>;
                clock-frequency = <0x384000>;
                reg = <0 0x10000000 0 0x100>;
                compatible = "ns16550a";
        };

        cpus {
                #address-cells = <1>;
                #size-cells = <0>;
                timebase-frequency = <166666>;

                cpu-map {
                        cluster0 {
                                core0 {
                                        cpu = <&cpu0>;
                                };
                        };
                };

                cpu0: cpu@0 {
                        device_type = "cpu";
                        reg = <0>;
                        status = "okay";
                        compatible = "riscv";
                        riscv,isa = "rv64imacsu";
                        mmu-type = "riscv,sv39";

                        cpu_intc: interrupt-controller {
                                #interrupt-cells = <1>;
                                interrupt-controller;
                                compatible = "riscv,cpu-intc";
                        };
                };
        };

        soc {
                #address-cells = <2>;
                #size-cells = <2>;
                compatible = "simple-bus";
                ranges;

                plic: interrupt-controller@c000000 {
                        riscv,ndev = <0x35>;
                        reg = <0 0xc000000 0 0x4000000>;
                        interrupts-extended = <&cpu_intc 0xb &cpu_intc 9>;
                        interrupt-controller;
                        compatible = "riscv,plic0";
                        #interrupt-cells = <1>;
                        #address-cells = <0>;
                };

                clint@2000000 {
                        interrupts-extended = <&cpu_intc 3 &cpu_intc 7>;
                        reg = <0 0x2000000 0 0x10000>;
                        compatible = "riscv,clint0";
                };
        };

        memory@80000000 {
                device_type = "memory";
                reg = <0 0x80000000 0 0x07fff000>;
        };
};
